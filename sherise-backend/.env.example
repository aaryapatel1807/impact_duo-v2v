# Database
DATABASE_URL=postgresql://user:password@host:5432/sherise

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Clerk publishable key (used by the frontend; listed for completeness)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Gemini model override (optional — defaults to the current GA Flash model)
# GEMINI_MODEL=gemini-3.8-flash

# Direct database URL (optional — for Prisma migrations against pooled hosts)
# DIRECT_URL=postgresql://user:password@host:5432/dbname
